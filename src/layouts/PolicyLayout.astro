---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'es';
  altLangPath?: string;
  /** Short label shown in the breadcrumb trail and BreadcrumbList schema, e.g. "About" */
  breadcrumbLabel: string;
  h1: string;
  intro?: string;
  /** Shown next to the H1, e.g. "Last updated: August 20, 2026" */
  lastUpdated?: string;
}

const {
  title,
  description,
  lang = 'en',
  altLangPath,
  breadcrumbLabel,
  h1,
  intro,
  lastUpdated,
} = Astro.props;

const base = lang === 'es' ? '/es' : '';
const homeLabel = lang === 'en' ? 'Home' : 'Inicio';
---

<BaseLayout title={title} description={description} lang={lang} altLangPath={altLangPath}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: homeLabel, item: `https://miamidebthelp.com${base || '/'}` },
        { '@type': 'ListItem', position: 2, name: breadcrumbLabel },
      ],
    })} />
  </Fragment>

  <div class="wrap">
    <div class="policy-breadcrumb"><a href={base || '/'}>{homeLabel}</a> / {breadcrumbLabel}</div>

    <div class="policy-header">
      <h1>{h1}</h1>
      {lastUpdated && <div class="policy-updated">{lastUpdated}</div>}
      {intro && <p class="policy-intro">{intro}</p>}
    </div>

    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .policy-breadcrumb { font-size: 13px; color: var(--ink-soft); padding: 18px 0 0; }
  .policy-breadcrumb a { color: var(--teal-deep); text-decoration: none; font-weight: 600; }
  .policy-header { padding: 24px 0 8px; max-width: 760px; }
  .policy-header h1 {
    font-family: var(--serif); font-size: clamp(28px, 4vw, 40px); font-weight: 600;
    letter-spacing: -0.01em; line-height: 1.15; margin-bottom: 10px;
  }
  .policy-updated { font-size: 12.5px; color: var(--ink-soft); font-weight: 600; margin-bottom: 14px; }
  .policy-intro { font-size: 16.5px; color: var(--ink-soft); line-height: 1.6; max-width: 680px; }
  .prose { max-width: 720px; padding: 8px 0 56px; }
  .prose :global(h2) { font-family: var(--serif); font-size: 22px; font-weight: 600; margin: 36px 0 14px; }
  .prose :global(h3) { font-family: var(--serif); font-size: 17px; font-weight: 600; margin: 22px 0 10px; }
  .prose :global(p) { margin-bottom: 14px; color: var(--ink-soft); line-height: 1.65; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 16px 20px; color: var(--ink-soft); }
  .prose :global(li) { margin-bottom: 8px; line-height: 1.6; }
  .prose :global(a) { color: var(--teal-deep); font-weight: 600; }
  .prose :global(strong) { color: var(--ink); }
</style>
