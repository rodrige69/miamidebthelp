---
import BaseLayout from './BaseLayout.astro';
import '../styles/article-patterns.css';

interface Props {
  title: string;
  metaDescription: string;
  lang: 'en' | 'es';
  altLangPath?: string;
  category: string;
  datePublished: Date;
  dateModified: Date;
  reviewedBy: string;
  readTime: string;
  sources: string[];
  directAnswer: string;
  breadcrumbLabel: string;
  relatedCategorySlug?: string;
  whatChanged?: { previous: string; current: string };
}

const {
  title,
  metaDescription,
  lang,
  altLangPath,
  datePublished,
  dateModified,
  reviewedBy,
  readTime,
  sources,
  directAnswer,
  breadcrumbLabel,
  relatedCategorySlug,
  whatChanged,
} = Astro.props;

const base = lang === 'es' ? '/es' : '';
const reviewedLabel = lang === 'en' ? 'Last reviewed' : 'Última revisión';
const shortAnswerLabel = lang === 'en' ? 'Short answer:' : 'Respuesta breve:';
const changedTitle = lang === 'en' ? "What's changed since our last review" : 'Qué ha cambiado desde nuestra última revisión';
const changedPrevTag = lang === 'en' ? 'Previous' : 'Anterior';
const changedCurrTag = lang === 'en' ? 'Current' : 'Actual';
const guidesLabel = lang === 'en' ? 'Guides' : 'Guías';
const homeLabel = lang === 'en' ? 'Home' : 'Inicio';

const dateFmt = new Intl.DateTimeFormat(lang === 'es' ? 'es-US' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={metaDescription} lang={lang} altLangPath={altLangPath}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      datePublished: datePublished.toISOString().slice(0, 10),
      dateModified: dateModified.toISOString().slice(0, 10),
      author: { '@type': 'Person', name: reviewedBy },
      publisher: { '@type': 'Organization', name: 'Miami Debt Help' },
      inLanguage: lang,
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: homeLabel, item: `https://miamidebthelp.com${base || '/'}` },
        { '@type': 'ListItem', position: 2, name: guidesLabel, item: `https://miamidebthelp.com${base}${lang === 'es' ? '/guias' : '/guides'}/` },
        { '@type': 'ListItem', position: 3, name: breadcrumbLabel },
      ],
    })} />
  </Fragment>

  <div class="wrap">
    <div class="breadcrumb">
      <a href={base || '/'}>{homeLabel}</a> / <a href={`${base}${lang === 'es' ? '/guias' : '/guides'}/`}>{guidesLabel}</a> / {breadcrumbLabel}
    </div>

    <div class="article-header">
      <div class="article-meta">
        <span class="reviewed">✓ {reviewedLabel}: {dateFmt.format(dateModified)}</span>
        <span>{readTime}</span>
        <span class="byline">{lang === 'en' ? 'Sources' : 'Fuentes'}: {sources.join(', ')}</span>
      </div>
      <h1>{title}</h1>
    </div>

    <div class="direct-answer">
      <strong>{shortAnswerLabel}</strong> {directAnswer}
    </div>

    <div class="ad-slot ad-slot--leaderboard" role="complementary" aria-label="Advertisement">
      <span>Advertisement</span><span class="ad-label">728×90 — AdSense / Programmatic</span>
    </div>

    <div class="content-layout">
      <div class="prose">
        <slot />

        {whatChanged && (
          <div class="changed-box">
            <h4>{changedTitle}</h4>
            <div class="changed-row prev"><span class="tag">{changedPrevTag}</span><span>{whatChanged.previous}</span></div>
            <div class="changed-row curr"><span class="tag">{changedCurrTag}</span><span>{whatChanged.current}</span></div>
          </div>
        )}
      </div>

      <aside class="sidebar">
        <div class="related-box">
          <h4>{lang === 'en' ? 'Related resources' : 'Recursos relacionados'}</h4>
          <ul>
            {relatedCategorySlug && (
              <li><a href={`${base}/${relatedCategorySlug}/`}>{lang === 'en' ? 'View verified resources →' : 'Ver recursos verificados →'}</a></li>
            )}
            <li><a href={`${base}${lang === 'es' ? '/guias' : '/guides'}/`}>{lang === 'en' ? 'All guides →' : 'Todas las guías →'}</a></li>
          </ul>
        </div>
        <div class="ad-slot ad-slot--sidebar" role="complementary" aria-label="Advertisement">
          <span>Advertisement</span><span class="ad-label">300×250</span>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .breadcrumb { font-size: 13px; color: var(--ink-soft); padding: 18px 0 0; }
  .breadcrumb a { color: var(--teal-deep); text-decoration: none; font-weight: 600; }
  .article-header { padding: 24px 0 28px; max-width: 760px; }
  .article-meta { display: flex; gap: 16px; align-items: center; font-size: 12.5px; color: var(--ink-soft); margin-bottom: 14px; flex-wrap: wrap; }
  .article-meta .reviewed { background: #e7f1ea; color: var(--teal-mid); padding: 4px 10px; border-radius: 20px; font-weight: 700; }
  .article-meta .byline { font-weight: 600; color: var(--ink); }
  .article-header h1 { font-family: var(--serif); font-size: clamp(28px, 4vw, 42px); font-weight: 600; letter-spacing: -0.01em; line-height: 1.12; margin-bottom: 16px; }
  .direct-answer { background: #fff; border-left: 4px solid var(--teal-deep); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; padding: 20px 24px; margin: 0 0 32px; font-size: 16px; color: var(--ink); max-width: 720px; }
  .direct-answer strong { color: var(--teal-deep); }
  .prose { max-width: 720px; }
  .prose :global(h2) { font-family: var(--serif); font-size: 24px; font-weight: 600; margin: 36px 0 14px; }
  .prose :global(h3) { font-family: var(--serif); font-size: 19px; font-weight: 600; margin: 24px 0 10px; }
  .prose :global(p) { margin-bottom: 14px; color: var(--ink-soft); line-height: 1.65; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 16px 20px; color: var(--ink-soft); }
  .prose :global(li) { margin-bottom: 8px; line-height: 1.6; }
  .prose :global(a) { color: var(--teal-deep); font-weight: 600; }
  .related-box { background: #fff; border: 1px solid var(--divider); border-radius: var(--radius-md); padding: 22px; margin: 24px 0; }
  .related-box h4 { font-family: var(--serif); font-size: 15px; margin-bottom: 12px; }
  .related-box ul { margin: 0; list-style: none; }
  .related-box li { margin-bottom: 8px; }
  .changed-box { background: #f4faf6; border: 1px solid #bfdbc9; border-radius: var(--radius-md); padding: 20px 22px; margin: 24px 0; }
  .changed-box h4 { font-family: var(--serif); font-size: 15px; color: var(--teal-deep); margin-bottom: 10px; }
  .changed-row { display: grid; grid-template-columns: auto 1fr; gap: 10px; font-size: 13.5px; margin-bottom: 6px; }
  .changed-row .tag { font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: 0.03em; }
  .changed-row.prev .tag { color: var(--ink-soft); }
  .changed-row.curr .tag { color: var(--teal-mid); }
</style>
