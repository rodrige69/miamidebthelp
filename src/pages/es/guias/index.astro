---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const articles = (await getCollection('articles', ({ id }) => id.startsWith('es/'))).sort(
  (a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf()
);

const title = 'Guías — Miami Debt Help';
const description = 'Guías con fuentes verificadas sobre alivio de deudas, asesoría de crédito, deudas médicas y protección al consumidor para residentes de Miami-Dade.';
---

<BaseLayout title={title} description={description} lang="es" altLangPath="/guides/">
  <div class="wrap">
    <div class="breadcrumb"><a href="/es">Inicio</a> / Guías</div>

    <div class="page-title-block">
      <h1>Guías</h1>
      <p>Cada afirmación tiene una fuente identificada y fechada.</p>
    </div>

    <div class="guides-grid">
      {articles.map((article) => (
        <a href={`/es/guias/${article.id.replace('es/', '').replace(/\.mdx$/, '')}/`} class="guide-card">
          <div class="gc-meta">{article.data.readTime} · {article.data.category}</div>
          <h2>{article.data.title}</h2>
          <p>{article.data.metaDescription}</p>
          <span class="gc-link">Leer guía →</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .breadcrumb { font-size: 13px; color: var(--ink-soft); padding: 18px 0 0; }
  .breadcrumb a { color: var(--teal-deep); text-decoration: none; font-weight: 600; }
  .page-title-block { padding: 24px 0 32px; max-width: 640px; }
  .page-title-block h1 { font-family: var(--serif); font-size: clamp(30px, 4vw, 42px); font-weight: 600; margin-bottom: 12px; }
  .page-title-block p { color: var(--ink-soft); font-size: 16px; }
  .guides-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; padding-bottom: 56px; }
  .guide-card {
    background: #fff; border: 1px solid var(--divider); border-radius: var(--radius-md);
    padding: 24px; text-decoration: none; color: var(--ink); display: block;
    transition: border-color 0.15s, transform 0.15s;
  }
  .guide-card:hover { border-color: var(--teal-deep); transform: translateY(-2px); }
  .gc-meta { font-size: 11.5px; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; color: var(--teal-mid); margin-bottom: 10px; }
  .guide-card h2 { font-family: var(--serif); font-size: 19px; font-weight: 600; line-height: 1.3; margin-bottom: 10px; }
  .guide-card p { font-size: 14px; color: var(--ink-soft); line-height: 1.5; margin-bottom: 14px; }
  .gc-link { font-size: 13px; font-weight: 700; color: var(--teal-deep); }
  @media (max-width: 680px) {
    .guides-grid { grid-template-columns: 1fr; }
  }
</style>
