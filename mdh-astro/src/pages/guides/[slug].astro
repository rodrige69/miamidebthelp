---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ id }) => id.startsWith('en/'));
  return articles.map((article) => ({
    params: { slug: article.id.replace('en/', '').replace(/\.mdx$/, '') },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const data = article.data;

// Look up the Spanish translation's slug via translationKey, if it exists
const esArticles = await getCollection('articles', ({ id }) => id.startsWith('es/'));
const esMatch = esArticles.find((a) => a.data.translationKey === data.translationKey);
const altLangPath = esMatch ? `/es/guias/${esMatch.id.replace('es/', '').replace(/\.mdx$/, '')}/` : undefined;
---

<ArticleLayout
  title={data.title}
  metaDescription={data.metaDescription}
  lang="en"
  altLangPath={altLangPath}
  category={data.category}
  datePublished={data.datePublished}
  dateModified={data.dateModified}
  reviewedBy={data.reviewedBy}
  readTime={data.readTime}
  sources={data.sources}
  directAnswer={data.metaDescription}
  breadcrumbLabel={data.title}
  relatedCategorySlug={data.relatedCategorySlug}
  whatChanged={data.whatChanged}
>
  <Content />
</ArticleLayout>
